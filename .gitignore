# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# environment & sensitive configuration files
.env
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# keys, certificates, credentials
*.pem
*.crt
*.key
*.keystore
*.jks
*.p12
*.pfx
release-key.jks
key.properties
local.properties
google-services.json
GoogleService-Info.plist
android/app/release-key.jks
android/app/key.properties
android/local.properties

# android & build outputs
/build
/android/app/build
/android/.gradle
/android/captures
/.next/
/out/

# test reports & logs
/coverage
/playwright-report
/test-results
lighthouse-report.html

# generated service worker / PWA scripts
public/sw.js
public/workbox-*.js

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# vercel & typescript
.vercel
*.tsbuildinfo
next-env.d.ts

